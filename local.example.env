# Ultra-light 24/7 manager. Copy to ~/.config/nesus-ai/local.env.

NESUS_MANAGER_ENABLED=1
NESUS_MANAGER_INTERVAL=60
NESUS_MANAGER_SETTLE_SECONDS=15
NESUS_MANAGER_MIN_AI_MEMORY_MIB=350
NESUS_MANAGER_MAX_AI_LOAD_1M=0.80
NESUS_MANAGER_AI_TIMEOUT=900
NESUS_MANAGER_ORCHESTRATOR_BIN=nesus_ai

# Absolute priority service. Replace commands only if your unit/process differs.
NESUS_PRIORITY_SERVICE_NAME=AI_TRADING_VM_ULTIMATE
NESUS_PRIORITY_SERVICE_PROJECT_DIR=/srv/AI_TRADING_VM_ULTIMATE
NESUS_PRIORITY_SERVICE_HEALTH_CMD=systemctl is-active --quiet AI_TRADING_VM_ULTIMATE
NESUS_PRIORITY_SERVICE_RECOVERY_CMD=systemctl restart AI_TRADING_VM_ULTIMATE

# Checked and recovered only when the priority service is healthy.
NESUS_SECONDARY_SERVICE_NAME=AI_TRADING_BOT_BUSINESS
NESUS_SECONDARY_SERVICE_PROJECT_DIR=/srv/AI_TRADING_BOT_BUSINESS
NESUS_SECONDARY_SERVICE_HEALTH_CMD=systemctl is-active --quiet AI_TRADING_BOT_BUSINESS
NESUS_SECONDARY_SERVICE_RECOVERY_CMD=systemctl restart AI_TRADING_BOT_BUSINESS

# Optional local llama.cpp fallback. Keep disabled on a saturated VM.
NESUS_LOCAL_LLM_ENABLED=0
NESUS_LOCAL_LLM_BIN=llama-server
NESUS_LOCAL_LLM_HOST=127.0.0.1
NESUS_LOCAL_LLM_PORT=8080
NESUS_LOCAL_LLM_CONTEXT=512
NESUS_LOCAL_LLM_THREADS=1
NESUS_LOCAL_MODEL_FILE=
NESUS_LOCAL_MODEL_HF=
NESUS_LOCAL_LLM_EXTRA_ARGS=
