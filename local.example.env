# Optional local llama.cpp standby server.
# Copy to ~/.config/nesus-ai/local.env and keep disabled until configured.

NESUS_LOCAL_LLM_ENABLED=0
NESUS_LOCAL_LLM_BIN=llama-server
NESUS_LOCAL_LLM_HOST=127.0.0.1
NESUS_LOCAL_LLM_PORT=8080

# e2-micro-safe starting point: tiny context and one CPU thread.
NESUS_LOCAL_LLM_CONTEXT=1024
NESUS_LOCAL_LLM_THREADS=1

# Configure exactly one source.
# Preferred on a 1 GB VM: a sub-1B Q4 GGUF file already downloaded locally.
NESUS_LOCAL_MODEL_FILE=

# Optional Hugging Face source supported by llama.cpp.
# Q8 can be too tight on a 1 GB VM once the OS and KV cache are included.
NESUS_LOCAL_MODEL_HF=

# Optional raw llama-server arguments. Keep this empty unless needed.
NESUS_LOCAL_LLM_EXTRA_ARGS=
